#!/bin/python3

import os
import sys

def stringConstruction(s):
    return len(set(s))


if __name__ == '__main__':
    fptr = open(os.environ['OUTPUT_PATH'], 'w')

    q = int(input().strip())

    for _ in range(q):
        s = input().strip()
        result = stringConstruction(s)
        fptr.write(str(result) + '\n')

    fptr.close()
