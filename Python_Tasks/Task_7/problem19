s = input().strip()
n = int(input())

weights = set()
previous = ""
current_weight = 0

for ch in s:
    if ch == previous:
        current_weight += ord(ch) - ord("a") + 1
    else:
        current_weight = ord(ch) - ord("a") + 1

    weights.add(current_weight)
    previous = ch

for _ in range(n):
    x = int(input())

    if x in weights:
        print("Yes")
    else:
        print("No")
