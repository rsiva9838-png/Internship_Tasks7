def separateNumbers(s):
    for length in range(1, len(s) // 2 + 1):
        first = int(s[:length])
        current = first
        built = ""

        while len(built) < len(s):
            built += str(current)
            current += 1

        if built == s:
            print("YES", first)
            return

    print("NO")


q = int(input())

for _ in range(q):
    s = input().strip()
    separateNumbers(s)
